<Window x:Class="VantreLingo.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VantreLingo.Desktop.Views"
        Title="VantreLingo · 设置" Width="860" Height="760" MinWidth="650" MinHeight="530"
        WindowStartupLocation="CenterOwner">
  <TabControl x:Name="SettingsTabs" Margin="12"><TabItem Header="设置">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#A04431" Margin="0,12,0,12" />
      <StackPanel Orientation="Horizontal">
        <Button Content="保存" Click="Save_Click" />
        <Button Content="导出普通设置" Click="ExportSettings_Click"/>
        <Button Content="关闭" Click="Close_Click" />
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Provider" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />
        <WrapPanel Margin="0,0,0,12"><ComboBox x:Name="ProviderList" Width="230" DisplayMemberPath="Name" SelectionChanged="Provider_Changed"/><Button Content="新增" Click="NewProvider_Click"/><Button Content="删除" Click="RemoveProvider_Click"/></WrapPanel>
        <TextBlock Text="显示名称"/><TextBox x:Name="ProviderName" Margin="0,4,0,12"/>
        <TextBlock Text="API 基础地址（例如 https://api.openai.com/v1/）" Margin="0,0,0,6" />
        <TextBox x:Name="EndpointText" Margin="0,0,0,12" />
        <TextBlock Text="模型名称" Margin="0,0,0,6" />
        <TextBox x:Name="ModelText" Margin="0,0,0,12" />
        <TextBlock Text="API key（留空保留已保存的密钥）" Margin="0,0,0,6" />
        <PasswordBox x:Name="ApiKeyText" Padding="8" Margin="0,0,0,8" />
        <CheckBox x:Name="RemoveKeyCheck" Content="清除已保存的密钥" Margin="0,0,0,12" />
        <TextBlock Text="超时（秒，5–300）" Margin="0,0,0,6" />
        <TextBox x:Name="TimeoutText" Margin="0,0,0,18" />
        <TextBlock Text="温度（可选，0–2；不兼容的服务留空）"/><TextBox x:Name="TemperatureText" Margin="0,4,0,12"/>
        <TextBlock Text="最大输出 tokens（可选，256–65536）"/><TextBox x:Name="MaxOutputText" Margin="0,4,0,12"/>
        <CheckBox x:Name="JsonModeCheck" Content="使用 response_format: json_object（opencode / Go 自建网关不支持时取消勾选）" Margin="0,0,0,6" />
        <TextBlock Text="自定义请求头（可选，每行一个 Name: Value；常用于 x-api-key / x-title 等透传）"/><TextBox x:Name="HeadersText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="60" Margin="0,4,0,12"/>
        <TextBlock Text="免费翻译引擎（默认热键走免费，同一热键另加 Ctrl 走模型）"/><ComboBox x:Name="FreeEngine" SelectedValuePath="Tag" Margin="0,4,0,12"><ComboBoxItem Content="谷歌免费接口" Tag="google"/><ComboBoxItem Content="微软免费接口" Tag="microsoft"/></ComboBox>
        <TextBlock Text="快捷键" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
        <TextBlock Text="阅读翻译（留空停用）" Margin="0,0,0,6" />
        <TextBox x:Name="ReadHotkeyText" Margin="0,0,0,12" />
        <TextBlock Text="写作翻译（留空停用）" Margin="0,0,0,6" />
        <TextBox x:Name="WriteHotkeyText" Margin="0,0,0,12" />
        <TextBlock Text="截图取字（留空停用）"/><TextBox x:Name="OcrHotkeyText" Margin="0,4,0,12"/>
        <TextBlock Text="复制并翻译：先模拟 Ctrl+C 取词再翻译（默认 Alt+C，留空停用）"/><TextBox x:Name="ClipboardHotkeyText" Margin="0,4,0,12"/>
        <TextBlock Text="粘贴译文：在小窗有译文时替换/粘贴（默认 Alt+V，留空停用）"/><TextBox x:Name="PasteHotkeyText" Margin="0,4,0,12"/>
        <TextBlock Text="不带 Ctrl 的阅读/写作/复制热键走免费接口；按住 Ctrl 再按同一热键走模型（如 Alt+G 免费，Ctrl+Alt+G 走模型）。已含 Ctrl 的热键只走模型。全局热键总开关在托盘菜单，关闭时图标变灰。"
                   TextWrapping="Wrap" Foreground="#647085" Margin="0,0,0,12"/>
        <CheckBox x:Name="AutoCopyCheck" Content="选区失败时自动模拟 Ctrl+C 取词（浏览器/VS Code 兼容，默认关闭）" Margin="0,0,0,6" />
        <TextBlock Text="自动取词只在快捷键触发后试一次，不监听剪贴板，不恢复剪贴板；剪贴板无新内容时仍提示失败，可再按 Alt+C 手动翻译。"
                   TextWrapping="Wrap" Foreground="#647085" Margin="0,0,0,12" />
        <TextBlock Text="本地 OCR 语言（系统已安装能力，与翻译语种独立）"/><ComboBox x:Name="OcrLanguage" DisplayMemberPath="Label" SelectedValuePath="Code" Margin="0,4,0,8"/><TextBlock x:Name="OcrStatus" TextWrapping="Wrap" Foreground="#647085" Margin="0,0,0,12"/>
        <TextBlock Text="目标语言策略"/><ComboBox x:Name="LanguageMode" SelectedValuePath="Tag" Margin="0,4,0,8"><ComboBoxItem Content="智能：外语→中文，中文→最近外语" Tag="smart"/><ComboBoxItem Content="固定目标语言" Tag="fixed"/></ComboBox>
        <TextBlock Text="固定目标语言代码（如 ja、de、fr）"/><TextBox x:Name="FixedTargetText" Margin="0,4,0,12"/>
        <TextBlock Text="写作模式" Margin="0,0,0,6" />
        <ComboBox x:Name="WritingMode" SelectedValuePath="Tag" Margin="0,0,0,8">
          <ComboBoxItem Content="审查后应用（默认）" Tag="review" />
          <ComboBoxItem Content="快速写回" Tag="fast" />
        </ComboBox>
        <TextBlock Text="写回方式" Margin="0,0,0,6" />
        <ComboBox x:Name="WritebackMode" SelectedValuePath="Tag" Margin="0,0,0,8">
          <ComboBoxItem Content="自动：原生优先，失败转粘贴（默认）" Tag="auto" />
          <ComboBoxItem Content="原生安全写回" Tag="native" />
          <ComboBoxItem Content="剪贴板粘贴" Tag="paste" />
        </ComboBox>
        <TextBlock Text="快速模式仅对可验证选区的原生文本框自动写回；其他控件保留结果供主动查看和复制。焦点或原文变化、译文有风险时不会自动写入。"
                   TextWrapping="Wrap" Foreground="#647085" Margin="0,0,0,12" />
        <CheckBox x:Name="ClearLanguageCheck" Content="清除最近外语记忆" Margin="0,0,0,12" />
        <TextBlock Text="仅在主动翻译或客户整理时向所选 Provider 发送输入文本。默认不保存正文或翻译历史，API key 由当前 Windows 用户加密保存。"
                   TextWrapping="Wrap" Foreground="#647085" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
  </TabItem><TabItem Header="风格与术语"><views:LibraryEditor/></TabItem></TabControl>
</Window>
