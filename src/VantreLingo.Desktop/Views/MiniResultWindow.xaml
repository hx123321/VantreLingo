<Window x:Class="VantreLingo.Desktop.Views.MiniResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VantreLingo" Width="380" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" MinHeight="140">
  <Border Padding="12">
    <StackPanel>
      <TextBlock x:Name="StatusLabel" Text="正在翻译…" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
      <TextBlock Text="原文" Foreground="#647085" FontSize="12" />
      <TextBlock x:Name="SourcePreview" Text="" TextWrapping="Wrap" MaxHeight="80"
                 TextTrimming="CharacterEllipsis" Foreground="#292447" Margin="0,2,0,8" />
      <TextBlock Text="译文" Foreground="#647085" FontSize="12" />
      <TextBox x:Name="TranslationBox" IsReadOnly="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" MaxHeight="160" MinHeight="48" Margin="0,2,0,8" />
      <TextBlock x:Name="WatchHint" Text="" Foreground="#647085" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" />
      <WrapPanel>
        <Button x:Name="CopyButton" Content="复制" Click="Copy_Click" IsEnabled="False" />
        <Button x:Name="PasteButton" Content="粘贴 Alt+V" Click="Paste_Click" IsEnabled="False" />
        <Button x:Name="ClipboardButton" Content="复制并翻译 Alt+C" Click="Clipboard_Click" />
        <Button x:Name="MainButton" Content="主窗口" Click="Main_Click" />
        <Button x:Name="CloseButton" Content="关闭" Click="Close_Click" />
      </WrapPanel>
    </StackPanel>
  </Border>
</Window>
