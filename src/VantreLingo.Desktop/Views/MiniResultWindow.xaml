<Window x:Class="VantreLingo.Desktop.Views.MiniResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VantreLingo" Width="320" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" MinHeight="80" MaxHeight="420">
  <Border Padding="14,12">
    <StackPanel>
      <TextBlock x:Name="StatusLabel" Text="正在翻译…" FontSize="12" Foreground="#647085" TextWrapping="Wrap" Margin="0,0,0,6" />
      <TextBox x:Name="TranslationBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
               Background="Transparent" FontSize="15" VerticalScrollBarVisibility="Auto"
               MaxHeight="240" MinHeight="24" Margin="0,0,0,6" ToolTip="点击复制译文" Cursor="Hand" />
      <TextBlock x:Name="SourcePreview" Text="" FontSize="12" Foreground="#94A3B8" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" MaxWidth="290" />
      <TextBlock x:Name="WatchHint" Text="" Foreground="#647085" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
    </StackPanel>
  </Border>
</Window>
